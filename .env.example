# Modèle de configuration : copier ce fichier en .env puis adapter les valeurs.
# Ce fichier est versionné : NE JAMAIS y mettre de secret.

# Environnement d'exécution : dev, test ou prod
APP_ENV=dev

# Niveau de journalisation : DEBUG, INFO, WARNING ou ERROR
LOG_LEVEL=INFO

# --- Base de données PostgreSQL (Docker) ---
POSTGRES_USER=fire_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fire_safety
# Port exposé sur l'hôte (uniquement sur 127.0.0.1)
POSTGRES_PORT=5432
