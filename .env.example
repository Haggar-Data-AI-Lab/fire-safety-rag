# Modèle de configuration : copier ce fichier en .env puis adapter les valeurs.
# Ce fichier est versionné : NE JAMAIS y mettre de secret.

# Environnement d'exécution : dev, test ou prod
APP_ENV=dev

# Niveau de journalisation : DEBUG, INFO, WARNING ou ERROR
LOG_LEVEL=INFO

# Modèle d'embedding (Hugging Face). En changer impose de revectoriser le corpus.
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# Seuil de refus (similarité cosinus du meilleur passage) : en dessous, pas
# d'appel au LLM. Lié au modèle d'embedding : à remesurer s'il change
# (python -m fire_safety_rag.evaluation.threshold).
REFUSAL_MIN_SCORE=0.84

# --- LLM (API Anthropic) ---
# Clé créée sur la console Anthropic (platform.claude.com). SECRÈTE : à mettre
# uniquement dans .env, jamais ici. Laisser vide tant qu'aucun appel réel n'est fait.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
# Profondeur de réflexion : low, medium, high, xhigh ou max (facturée en sortie)
LLM_EFFORT=low
# Plafond de tokens générés (réflexion + réponse)
LLM_MAX_TOKENS=2000
LLM_TIMEOUT_SECONDS=60
# Nouvelles tentatives automatiques sur erreur passagère (429, 5xx, réseau)
LLM_MAX_RETRIES=2

# --- Base de données PostgreSQL (Docker) ---
POSTGRES_USER=fire_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fire_safety
# Port exposé sur l'hôte (uniquement sur 127.0.0.1)
POSTGRES_PORT=5432
